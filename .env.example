VITE_APP_TITLE=denuwe

# Local: relative /api/v1 is proxied by Vite to VITE_APP_URL (Laravel).
# Split deploy (e.g. Vercel → Hostinger): set the absolute API URL (see .env.vercel.example).
VITE_API_BASE_URL=/api/v1

# Local UI origin (Open Graph / meta). Optional in production builds.
VITE_FRONTEND_URL=http://localhost:3000

# Local only — must match Laravel APP_URL (used by Vite /api proxy).
# Not used in production builds.
VITE_APP_URL=http://localhost:8000

# Laravel Reverb (real-time chat). Only the PUBLIC app key goes here — never REVERB_APP_SECRET.
# Copy REVERB_APP_KEY from denuwe-ws/.env. Leave the key empty to turn real-time off.
VITE_REVERB_APP_KEY=
VITE_REVERB_HOST=127.0.0.1
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http

# Native app links for the login page's Download buttons (Microsoft Store / Windows installer,
# Google Play, App Store; https only). Leave empty to install denuwe as a web app (PWA) instead.
VITE_APP_DOWNLOAD_URL_PC=
VITE_APP_DOWNLOAD_URL_ANDROID=
VITE_APP_DOWNLOAD_URL_IOS=
