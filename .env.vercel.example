# Copy into Vercel → Project → Settings → Environment Variables
# (Production), then Redeploy. Vite bakes these in at build time.

VITE_APP_TITLE=denuwe

# MUST include /api/v1 (Laravel lives under /api).
VITE_API_BASE_URL=https://your-denuwe-site.hostingersite.com/api/v1

VITE_FRONTEND_URL=https://your-denuwe-frontend.vercel.app

# Real-time chat (Laravel Reverb behind HTTPS → the browser connects with wss://).
# PUBLIC key only (REVERB_APP_KEY on the server) — never REVERB_APP_SECRET.
VITE_REVERB_APP_KEY=your-reverb-app-key
VITE_REVERB_HOST=ws.your-domain.com
VITE_REVERB_PORT=443
VITE_REVERB_SCHEME=https

# Native app links for the login page's Download buttons (https only).
# Leave empty to install denuwe as a web app (PWA) instead.
VITE_APP_DOWNLOAD_URL_PC=
VITE_APP_DOWNLOAD_URL_ANDROID=
VITE_APP_DOWNLOAD_URL_IOS=
